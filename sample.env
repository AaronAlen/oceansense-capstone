# ==============================================================================
# OceanSense Digital Twin — Root Sample Environment Configuration
# Copy this file to '.env' in this directory for Docker Compose & Full-Stack Deployment
# ==============================================================================

# Core Ports
PORT=5000
FRONTEND_PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Aaron123@
POSTGRES_DB=oceansense_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Complete PostgreSQL Connection String
# (Note: '@' in Aaron123@ is URL-encoded as '%40' for standard JDBC/PG drivers)
DATABASE_URL=postgresql://postgres:Aaron123%40@localhost:5432/oceansense_db

# Redis Cache Service
REDIS_URL=redis://localhost:6379

# Tactical Authentication Secret
JWT_SECRET=oceansense_tactical_jwt_secret_token_98472910384

# Underwater Sonar Mesh & Digital Twin Parameters
SIMULATION_DEFAULT_NODES=1000
SIMULATION_AREA_KM=10
SIMULATION_TICK_HZ=60

# Commercial Fisherman SaaS Subscription & Payments (Razorpay / UPI)
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=sample_secret_key_67890

# Maritime Anti-Theft SMS Alerts (Twilio)
TWILIO_ACCOUNT_SID=AC_sample_twilio_account_sid_here
TWILIO_AUTH_TOKEN=sample_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Maritime Anti-Theft Email Alerts (SendGrid / SMTP)
SENDGRID_API_KEY=SG.sample_sendgrid_api_key_here
EMAIL_FROM=alerts@oceansense.maritime

# Cloud Deployment (GCP / AWS CI/CD)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
