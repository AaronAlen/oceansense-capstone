# ==============================================================================
# OceanSense Core Backend — Sample Environment Configuration
# Copy this file to '.env' and update values as needed for your local environment
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://<user>:<encoded_password>@<host>:<port>/<database>
# Note: For password 'Aaron123@', '@' is URL-encoded as '%40'
DATABASE_URL=postgresql://postgres:Aaron123%40@localhost:5432/oceansense_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Aaron123@
POSTGRES_DB=oceansense_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Message Broker (Optional for local standalone simulation)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret
JWT_SECRET=oceansense_tactical_jwt_secret_token_98472910384

# Digital Twin Simulation Parameters
SIMULATION_DEFAULT_NODES=1000
SIMULATION_AREA_KM=10
SIMULATION_TICK_HZ=60

# Commercial Fisherman Subscription & Payment Gateway (Razorpay / UPI)
# Get keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=sample_secret_key_67890

# Maritime Security Alerts — SMS Notification (Twilio)
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC_sample_twilio_account_sid_here
TWILIO_AUTH_TOKEN=sample_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Maritime Security Alerts — Email Notification (SendGrid / SMTP)
SENDGRID_API_KEY=SG.sample_sendgrid_api_key_here
EMAIL_FROM=alerts@oceansense.maritime
