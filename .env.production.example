# ==============================================================================
# OCEANSENSE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or inject into GCP Cloud Run / AWS ECS Secret Manager
# ==============================================================================

# Server Core
NODE_ENV=production
PORT=5000

# Database (PostgreSQL 16)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Aaron123@
POSTGRES_DB=oceansense_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:Aaron123%40@postgres:5432/oceansense_db

# In-Memory Cache & Message Broker (Redis 7)
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=super_secure_production_jwt_secret_oceansense_2026

# Commercial Fisherman SaaS Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_here
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# International Credit Card Payments (Stripe - Optional)
STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_key_here
STRIPE_SECRET_KEY=sk_live_your_actual_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_actual_secret_here

# Maritime SMS / WhatsApp Emergency & Fish Alerts (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12055550123

# Transactional Billing & Tamper Email Alerts (SendGrid / Resend)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alerts@oceansense.io

# Digital Twin Simulation Parameters
SIMULATION_DEFAULT_NODES=1000
SIMULATION_AREA_KM=10
SIMULATION_TICK_HZ=60
